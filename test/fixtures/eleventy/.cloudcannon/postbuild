#!/usr/bin/env bash
set -euo pipefail

# Builds _cloudcannon/bookshop-live.js, injects the live-editing connector into
# pages containing components, and adds the components as CloudCannon structures.
npx @bookshop/generate

# 3-layer Rosey config resolution (CLI flag > env > rosey.yml):
#   rosey.yml  : baseline — source (=_site), locales dir, separator, tag,
#                default_language, languages ([fr])
#   env var    : ROSEY_LANGUAGES overrides languages → adds ar (so ar.json,
#                absent from the repo, is created on build)
#   CLI flag   : --source sets the connector's Rosey (base.json) directory
export ROSEY_LANGUAGES="[fr, ar]"

npx rosey generate
npx rosey-cloudcannon-connector write-locales --source rosey

# Puts the client at _site/_rcc/client.mjs, which base.liquid imports. No
# --dest: resolves from rosey.yml's `source: _site`, same as write-locales.
npx rosey-cloudcannon-connector install-client
